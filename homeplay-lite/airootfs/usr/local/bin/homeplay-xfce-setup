#!/usr/bin/env bash
set -euo pipefail

quiet=0
if [ "${1:-}" = "--quiet" ]; then
  quiet=1
fi

config_dir="${HOME}/.config/xfce4/xfconf/xfce-perchannel-xml"
source_dir="/usr/share/homeplay/xfce"
mkdir -p "$config_dir"

if [ -d "$source_dir" ]; then
  for config in "$source_dir"/*.xml; do
    [ -e "$config" ] || continue
    target="${config_dir}/$(basename "$config")"
    if [ ! -e "$target" ]; then
      cp "$config" "$target"
    fi
  done
fi

if command -v xfconf-query >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
  xfconf-query -c xfwm4 -p /general/use_compositing -n -t bool -s false >/dev/null 2>&1 || true
  xfconf-query -c xsettings -p /Net/ThemeName -n -t string -s "Adwaita" >/dev/null 2>&1 || true
  xfconf-query -c xsettings -p /Net/IconThemeName -n -t string -s "Adwaita" >/dev/null 2>&1 || true
  xfconf-query -c xsettings -p /Gtk/FontName -n -t string -s "DejaVu Sans 11" >/dev/null 2>&1 || true
  xfconf-query -c xfce4-desktop -p /desktop-icons/icon-size -n -t uint -s 48 >/dev/null 2>&1 || true
fi

if [ "$quiet" -eq 0 ] && command -v zenity >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
  zenity --info --title="Настройка интерфейса" --text="Интерфейс настроен для простого домашнего использования."
fi
